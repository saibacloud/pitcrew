# Google AI Studio key for Gemini
GENAI_API_KEY=

# Argon2id hash of the access code — generate with:
#   python -m backend.auth
PITCREW_CODE_HASH=

# HMAC key for signing session cookies — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PITCREW_SECRET_KEY=

# Optional — session lifetime in seconds (default 43200 / 12h)
# PITCREW_SESSION_TTL=43200

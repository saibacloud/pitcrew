# Argon2id hash of the 6-12 digit login PIN — generate with:
#   python -m backend.auth
PITCREW_PIN_HASH=

# HMAC key for signing session cookies and encrypting the stored AI key — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PITCREW_SECRET_KEY=

# Optional — the AI key is entered in Settings. Without one there, this Google AI Studio
# key is used for Gemini.
# GENAI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Optional — session lifetime in seconds (default 43200 / 12h)
# PITCREW_SESSION_TTL=43200

# Mechanic agent keys as label:sha256 pairs, comma-separated. Generate each with:
#   python -m backend.agent_keys LABEL
# Unset means no agent can connect; removing a label revokes it on the next start.
PITCREW_AGENT_KEYS=

# Optional — host address the container port is published on (default 127.0.0.1)
# BIND_IP=192.168.105.10
